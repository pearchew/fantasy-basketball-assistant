# Copy to .env.local for local runs; set the same values in Vercel project settings.

# Protects /api/spike. Any long random string, e.g. `openssl rand -hex 32`.
SPIKE_SECRET=

# Any OpenAI-compatible chat endpoint on a free tier (no card on file).
# Gemini (Google AI Studio key):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Groq (console.groq.com key):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
# Pick a current free model name from the provider's console.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Supabase (Project Settings → API Keys). The URL and publishable key are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only, bypasses row-level security. Used by the daily player sync.
SUPABASE_SECRET_KEY=

# Only this address is sent sign-in links.
ALLOWED_EMAIL=

# Vercel Cron sends this as a bearer token to /api/cron/sync-players.
CRON_SECRET=
